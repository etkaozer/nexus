{
  "name": "nexus-brain-mcp",
  "version": "0.1.0",
  "type": "module",
  "description": "Local stdio MCP server bridging Claude Desktop and an Obsidian vault — a second brain. Markdown is the source of truth; the index is a disposable projection.",
  "license": "MIT",
  "author": "etkaozer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/etkaozer/nexus.git"
  },
  "homepage": "https://github.com/etkaozer/nexus#readme",
  "bugs": {
    "url": "https://github.com/etkaozer/nexus/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "memory",
    "second-brain",
    "obsidian",
    "markdown",
    "local-first",
    "semantic-search"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "nexus-brain-mcp": "dist/main.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/*.test.*",
    "!dist/scripts/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node ./dist/main.js",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "prepack": "npm run clean && npm run build",
    "prebuilds": "node ./scripts/fetch-prebuilds.mjs",
    "preflight": "node ./scripts/preflight-mcpb.mjs",
    "pack:mcpb": "npm run build && npm run prebuilds && npm run preflight && mcpb pack . nexus.mcpb"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.11.1",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.2.1",
    "simple-git": "^3.36.0",
    "sqlite-vec": "^0.1.9",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  }
}
